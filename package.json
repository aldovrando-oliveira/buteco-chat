{
  "name": "buteco-chat",
  "productName": "Buteco Chat",
  "version": "0.1.0",
  "description": "Cliente desktop para conversar com agentes da plataforma Buteco Agentes.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Aldovrando Oliveira",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run --project main --project renderer",
    "test:build": "vitest run --project build",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@tabler/icons-react": "^3.49.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "local.butecochat.app",
    "productName": "Buteco Chat",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "identity": null,
      "target": "dir"
    },
    "publish": null,
    "files": [
      "out/**/*",
      "!node_modules/**/*"
    ]
  }
}
